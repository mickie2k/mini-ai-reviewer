PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# LLM_PROVIDER can be either "openai" or "anthropic".
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-5.4
LLM_MAX_TOKENS=2048

# LLM_URL is optional and can be used to specify an AI Gateway or custom endpoint.
# Leave empty to use the provider's official API.
# FYI: The format depends on LLM_PROVIDER, because each SDK use different paths pattern.
# openai: include /v1       e.g. http://localhost:1234/v1  
# anthropic: exclude /v1    e.g. http://localhost:1234     
LLM_URL=http://localhost:1234/v1


# Cache is Optional. Leave empty to disable the cache.
# Format: redis://<user>:<pass>@localhost:6379/<db> 
REDIS_URL=redis://localhost:6379/0

# Cached Review Expiration Time.
REVIEW_TTL=1h
